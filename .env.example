# Copy to .env and fill in. .env is gitignored and must stay that way.
#
# Only ai/run.py reads this. It runs on your machine, and the key is never
# bundled, never served, and never reaches the browser.
OPENAI_API_KEY=

# Optional. Both passes default to gpt-5.6-luna. Override either one, for
# example to sort on something cheaper than you draft on.
# SOLVD_SORT_MODEL=gpt-5.6-luna
# SOLVD_DRAFT_MODEL=gpt-5.6-luna
