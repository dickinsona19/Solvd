# Copy to .env and fill in. .env is gitignored and must stay that way.
#
# The live API service and ai/run.py read this. It is never bundled into the
# browser. Calls go through OpenAI's Responses API (see ai/model.py).
OPENAI_API_KEY=

# Optional. Both passes default to gpt-5.6-luna. Override either one, for
# example to sort on something cheaper than you draft on.
# SOLVD_SORT_MODEL=gpt-5.6-luna
# SOLVD_DRAFT_MODEL=gpt-5.6-luna

# Local defaults are test / 1234. Set strong values in Render production.
SOLVD_ENV=development
SOLVD_ACCOUNT_ID=test
SOLVD_ACCOUNT_USERNAME=test
SOLVD_ACCOUNT_PASSWORD=1234
SOLVD_SESSION_SECRET=replace-with-a-long-random-value
SOLVD_EMAIL_WEBHOOK_SECRET=replace-with-a-different-random-value
SOLVD_ADMIN_SECRET=replace-with-a-third-long-random-value

# Browser origins allowed to call the API, comma separated.
SOLVD_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local SQLite; Render injects its Postgres DATABASE_URL instead.
DATABASE_URL=sqlite:///./solvd.db

# Email input mode: auto uses IMAP when complete credentials exist, otherwise
# it loads accounts/<SOLVD_ACCOUNT_ID>/messages.json. Production processes that
# temporary JSON through OpenAI; local development uses inbox-ai.json by default.
SOLVD_EMAIL_SOURCE=auto
# SOLVD_FIXTURE_AI_MODE=cache

# Optional live mailbox polling. Leave the credentials empty for JSON mode.
SOLVD_IMAP_HOST=imap.gmail.com
SOLVD_IMAP_USERNAME=
SOLVD_IMAP_PASSWORD=
# SOLVD_EMAIL_POLL_SECONDS=15
# SOLVD_EMAIL_LOOKBACK_HOURS=168
# SOLVD_EMAIL_BATCH_LIMIT=25

# The static site needs this at build time when the API is on another origin.
# VITE_API_BASE_URL=https://solvd-inbox-api.onrender.com
